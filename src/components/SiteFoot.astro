---
// SiteFoot.astro - Editorial Technical Command Footer
---

<footer class="site-foot" id="site-footer">
  <div class="site-foot__container">
    <!-- Top System Telemetry Bar -->
    <div class="site-foot__telemetry">
      <div class="site-foot__status-badge">
        <span class="site-foot__led"></span>
        <span class="site-foot__status-text">SYSTEM STATUS: FULL DISPATCH // ZERO-DAY RESILIENT</span>
      </div>
      <div class="site-foot__coords">
        <span>DELHI · MUMBAI // INDIA (UTC+05:30)</span>
        <span class="site-foot__rule"></span>
        <span>SYS_CORE_ID: HK-2025</span>
      </div>
    </div>

    <!-- Main Headline: Deadly Combo of Security + Developer -->
    <div class="site-foot__hero">
      <div class="site-foot__eyebrow">
        <span class="site-foot__tag-bracket">[</span>
        <span class="site-foot__tag-text">THE UNCOMMON PARADIGM</span>
        <span class="site-foot__tag-bracket">]</span>
      </div>

      <h2 class="site-foot__heading">
        <span class="site-foot__heading-sub">DEADLY COMBO OF</span>
        <span class="site-foot__heading-main">
          <span class="site-foot__term site-foot__term--sec">SECURITY</span>
          <span class="site-foot__term-plus">+</span>
          <span class="site-foot__term site-foot__term--dev">DEVELOPER</span>
        </span>
      </h2>

      <p class="site-foot__statement">
        Most developers build without understanding how systems break. Most security analysts audit without knowing how to engineer high-scale distributed backends.
        <strong>I operate at the intersection</strong> — engineering resilient cloud-native architectures in Go, Rust, and eBPF with the paranoid precision of a HackerOne researcher.
      </p>
    </div>

    <!-- Dual Architecture Pillars: 01 Breaker vs 02 Builder -->
    <div class="site-foot__pillars">
      <!-- Pillar 1: Offensive Security -->
      <div class="site-foot__pillar site-foot__pillar--security">
        <div class="site-foot__pillar-corner site-foot__pillar-corner--tl"></div>
        <div class="site-foot__pillar-corner site-foot__pillar-corner--tr"></div>
        <div class="site-foot__pillar-corner site-foot__pillar-corner--bl"></div>
        <div class="site-foot__pillar-corner site-foot__pillar-corner--br"></div>

        <div class="site-foot__pillar-head">
          <div class="site-foot__pillar-idx">
            <span class="site-foot__pillar-num">01</span>
            <span class="site-foot__pillar-scope">// OFFENSIVE SECURITY</span>
          </div>
          <span class="site-foot__pillar-badge site-foot__pillar-badge--sec">THE BREAKER</span>
        </div>

        <div class="site-foot__pillar-title-wrap">
          <div class="site-foot__pillar-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <circle cx="12" cy="11" r="3"/>
              <path d="M12 8v-1M12 15v-1M9 11H8M16 11h-1"/>
            </svg>
          </div>
          <h3 class="site-foot__pillar-title">Vulnerability Hunter & Penetration Researcher</h3>
        </div>

        <p class="site-foot__pillar-desc">
          Auditing architectures from the outside-in. Uncovering race conditions, authorization bypasses, and distributed state vulnerabilities before adversaries do.
        </p>

        <ul class="site-foot__chips">
          <li class="site-foot__chip">HackerOne Top 4%</li>
          <li class="site-foot__chip">TryHackMe Top 4%</li>
          <li class="site-foot__chip">eBPF Packet Inspection</li>
          <li class="site-foot__chip">Kubernetes Admission Webhooks</li>
          <li class="site-foot__chip">CVE Audits & Threat Defense</li>
          <li class="site-foot__chip">Kali Linux & Metasploit</li>
        </ul>

        <div class="site-foot__pillar-foot">
          <span class="site-foot__foot-code">SIGNAL: 100+ VULNS RESOLVED</span>
          <span class="site-foot__foot-status">AUDITED & SECURED</span>
        </div>
      </div>

      <!-- Pillar 2: Systems Development -->
      <div class="site-foot__pillar site-foot__pillar--developer">
        <div class="site-foot__pillar-corner site-foot__pillar-corner--tl"></div>
        <div class="site-foot__pillar-corner site-foot__pillar-corner--tr"></div>
        <div class="site-foot__pillar-corner site-foot__pillar-corner--bl"></div>
        <div class="site-foot__pillar-corner site-foot__pillar-corner--br"></div>

        <div class="site-foot__pillar-head">
          <div class="site-foot__pillar-idx">
            <span class="site-foot__pillar-num">02</span>
            <span class="site-foot__pillar-scope">// SYSTEMS ENGINEERING</span>
          </div>
          <span class="site-foot__pillar-badge site-foot__pillar-badge--dev">THE BUILDER</span>
        </div>

        <div class="site-foot__pillar-title-wrap">
          <div class="site-foot__pillar-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 2 7 12 12 22 7 12 2"/>
              <polyline points="2 17 12 22 22 17"/>
              <polyline points="2 12 12 17 22 12"/>
            </svg>
          </div>
          <h3 class="site-foot__pillar-title">Cloud-Native Distributed Backend Engineer</h3>
        </div>

        <p class="site-foot__pillar-desc">
          Building the low-level distributed plumbing that keeps high-scale systems resilient. From kernel eBPF hooks to OVS network reconcilers and Tekton pipeline bundles.
        </p>

        <ul class="site-foot__chips">
          <li class="site-foot__chip">Kubernetes & KubeStellar Upstream</li>
          <li class="site-foot__chip">Kyverno Policy Contributor</li>
          <li class="site-foot__chip">Konflux CI/CD Top 2%</li>
          <li class="site-foot__chip">Cilium & Antrea SDN</li>
          <li class="site-foot__chip">Go · Rust · Node.js · Docker</li>
          <li class="site-foot__chip">High-Concurrency DistSystems</li>
        </ul>

        <div class="site-foot__pillar-foot">
          <span class="site-foot__foot-code">MERGED: CNCF UPSTREAM PRs</span>
          <span class="site-foot__foot-status">ENGINEERED TO SCALE</span>
        </div>
      </div>
    </div>

    <!-- Bottom Nav & Copyright Strip -->
    <div class="site-foot__bottom">
      <div class="site-foot__identity">
        <a href="#about" class="site-foot__monogram-link" title="Harsh Kumar">
          <svg
            width="40"
            height="40"
            viewBox="0 0 280 280"
            fill="none"
            class="site-foot__monogram-svg"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M0 0h40v120h40V0h40v280H80V160H40v120H0V0Zm160 0h40v90l48-90h32l-58 108 58 172h-32l-48-92v92h-40V0Z"
              fill="currentColor"
            />
          </svg>
        </a>
        <div class="site-foot__id-text">
          <span class="site-foot__author">HARSH KUMAR</span>
          <span class="site-foot__role">SECURITY RESEARCHER & CORE ENGINEER</span>
        </div>
      </div>

      <nav class="site-foot__nav" aria-label="Footer Quick Navigation">
        <a href="#hero" class="site-foot__nav-link"><span>01</span> DEV</a>
        <span class="site-foot__nav-slash">/</span>
        <a href="#about" class="site-foot__nav-link"><span>02</span> OPS</a>
        <span class="site-foot__nav-slash">/</span>
        <a href="#work" class="site-foot__nav-link"><span>03</span> SEC</a>
        <span class="site-foot__nav-slash">/</span>
        <a href="#contact" class="site-foot__nav-link"><span>04</span> OSS</a>
        <span class="site-foot__nav-slash">/</span>
        <a href="#contact" class="site-foot__nav-link"><span>05</span> CONNECT</a>
      </nav>

      <div class="site-foot__actions">
        <button
          type="button"
          class="site-foot__top-btn js-scroll-to-top"
          id="footer-scroll-top-btn"
          title="Return to Apex"
        >
          <span>RETURN TO TOP</span>
          <span class="site-foot__top-arrow">&uarr;</span>
        </button>
      </div>
    </div>

    <!-- Final System Disclaimer -->
    <div class="site-foot__disclaimer">
      <span>HARSH KUMAR · ARCHITECTED FOR ENDURANCE</span>
      <span>ALL RIGHTS RESERVED &copy; 2025 - 2026</span>
      <span>SEC_HASH: SHA256//DEADLY_COMBO</span>
    </div>
  </div>
</footer>

<script>
  // Smooth scroll to top button
  const topBtn = document.getElementById('footer-scroll-top-btn')
  if (topBtn) {
    topBtn.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth',
      })
    })
  }
</script>

<style lang="scss">
  .site-foot {
    position: relative;
    z-index: 3;
    width: 100%;
    background: color(primary);
    border-top: 1px solid color(secondary);
    color: color(secondary);
    overflow: hidden;

    &__container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 3.5rem 2.5rem 2rem;

      @include mq(tablet) {
        padding: 2.5rem 1.5rem 1.5rem;
      }

      @include mq(phone) {
        padding: 2rem 1rem 1.25rem;
      }
    }

    /* ─── Telemetry Bar ─── */
    &__telemetry {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid rgba(22, 0, 0, 0.12);
      font: 700 10.5px / 1.2 font-family(fraktion);
      letter-spacing: 0.14em;
      text-transform: uppercase;

      @include mq(phone) {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
        font-size: 9.5px;
      }
    }

    &__status-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      color: #0e4a2f;
    }

    &__led {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #39e75f;
      box-shadow: 0 0 8px #39e75f;
      animation: site-foot-pulse 2s infinite ease-in-out;
    }

    &__coords {
      display: inline-flex;
      align-items: center;
      gap: 0.8rem;
      opacity: 0.65;
    }

    &__rule {
      display: inline-block;
      width: 18px;
      height: 1px;
      background: currentColor;
      opacity: 0.4;
    }

    /* ─── Hero Statement ─── */
    &__hero {
      padding: 3rem 0 2.5rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;

      @include mq(phone) {
        padding: 2rem 0 1.75rem;
      }
    }

    &__eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      margin-bottom: 1rem;
      font: 700 11px / 1 font-family(fraktion);
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: #246b45;
    }

    &__tag-bracket {
      color: #39e75f;
      font-weight: 800;
    }

    &__heading {
      margin: 0 0 1.25rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.35rem;
    }

    &__heading-sub {
      font: 700 clamp(0.9rem, 2vw, 1.25rem) / 1 font-family(fraktion);
      letter-spacing: 0.28em;
      text-transform: uppercase;
      opacity: 0.65;
    }

    &__heading-main {
      font: 800 clamp(1.85rem, 5.2vw, 4.2rem) / 1.05 font-family(bigger);
      letter-spacing: 0.04em;
      text-transform: uppercase;
      display: inline-flex;
      align-items: center;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.4em;
    }

    &__term--sec {
      color: #0e4a2f;
      background: linear-gradient(135deg, #0e4a2f 0%, #246b45 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      text-shadow: 0 2px 14px rgba(36, 107, 69, 0.15);
    }

    &__term-plus {
      color: #39e75f;
      font-family: font-family(fraktion);
      font-weight: 900;
      font-size: 0.75em;
    }

    &__term--dev {
      color: color(secondary);
      letter-spacing: 0.05em;
    }

    &__statement {
      max-width: 820px;
      margin: 0 auto;
      font: 400 clamp(0.95rem, 1.4vw, 1.15rem) / 1.65 font-family(sans);
      color: rgba(22, 0, 0, 0.78);

      strong {
        color: color(secondary);
        font-weight: 700;
      }

      @include mq(phone) {
        font-size: 0.9rem;
        line-height: 1.55;
      }
    }

    /* ─── Dual Architecture Pillars ─── */
    &__pillars {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
      margin-bottom: 3.5rem;

      @include mq(tablet) {
        grid-template-columns: 1fr;
        gap: 1.25rem;
        margin-bottom: 2.5rem;
      }
    }

    &__pillar {
      position: relative;
      padding: 1.85rem;
      background: rgba(255, 255, 255, 0.55);
      border: 1px solid rgba(22, 0, 0, 0.12);
      border-radius: 8px;
      backdrop-filter: blur(10px);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
      display: flex;
      flex-direction: column;
      gap: 1rem;
      transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);

      &:hover {
        background: rgba(255, 255, 255, 0.85);
        transform: translateY(-2px);
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.05);
      }

      &--security:hover {
        border-color: #246b45;
      }

      &--developer:hover {
        border-color: color(secondary);
      }

      @include mq(phone) {
        padding: 1.35rem;
      }
    }

    /* Corner cyber brackets */
    &__pillar-corner {
      position: absolute;
      width: 7px;
      height: 7px;
      pointer-events: none;
      opacity: 0.55;

      &--tl {
        top: 4px; left: 4px;
        border-top: 1.5px solid #246b45;
        border-left: 1.5px solid #246b45;
      }
      &--tr {
        top: 4px; right: 4px;
        border-top: 1.5px solid #246b45;
        border-right: 1.5px solid #246b45;
      }
      &--bl {
        bottom: 4px; left: 4px;
        border-bottom: 1.5px solid #246b45;
        border-left: 1.5px solid #246b45;
      }
      &--br {
        bottom: 4px; right: 4px;
        border-bottom: 1.5px solid #246b45;
        border-right: 1.5px solid #246b45;
      }
    }

    &__pillar-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
    }

    &__pillar-idx {
      display: inline-flex;
      align-items: baseline;
      gap: 0.5rem;
      font: 700 11px / 1 font-family(fraktion);
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    &__pillar-num {
      color: #246b45;
      font-weight: 800;
    }

    &__pillar-scope {
      opacity: 0.75;
    }

    &__pillar-badge {
      font: 700 9px / 1 font-family(fraktion);
      letter-spacing: 0.18em;
      text-transform: uppercase;
      padding: 3px 8px;
      border-radius: 999px;

      &--sec {
        background: rgba(36, 107, 69, 0.12);
        color: #0e4a2f;
        border: 1px solid rgba(36, 107, 69, 0.28);
      }

      &--dev {
        background: rgba(22, 0, 0, 0.08);
        color: color(secondary);
        border: 1px solid rgba(22, 0, 0, 0.2);
      }
    }

    &__pillar-title-wrap {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }

    &__pillar-icon {
      width: 38px;
      height: 38px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 6px;
      background: rgba(36, 107, 69, 0.08);
      color: #0e4a2f;

      svg {
        width: 22px;
        height: 22px;
      }
    }

    &__pillar-title {
      margin: 0;
      font: 700 clamp(1rem, 1.4vw, 1.25rem) / 1.3 font-family(fraktion);
      letter-spacing: 0.02em;
      color: color(secondary);
    }

    &__pillar-desc {
      margin: 0;
      font: 400 0.95rem / 1.6 font-family(sans);
      color: rgba(22, 0, 0, 0.75);

      @include mq(phone) {
        font-size: 0.875rem;
      }
    }

    &__chips {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
    }

    &__chip {
      font: 700 10px / 1 font-family(fraktion);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      padding: 5px 9px;
      border-radius: 4px;
      background: rgba(255, 255, 255, 0.7);
      border: 1px solid rgba(22, 0, 0, 0.1);
      color: #0e4a2f;
      transition: all 0.2s ease;

      &:hover {
        background: #ffffff;
        border-color: #39e75f;
      }
    }

    &__pillar-foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      padding-top: 0.85rem;
      margin-top: auto;
      border-top: 1px dashed rgba(22, 0, 0, 0.12);
      font: 700 9.5px / 1 font-family(fraktion);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      opacity: 0.75;

      @include mq(phone) {
        font-size: 8.5px;
      }
    }

    &__foot-code {
      color: #246b45;
    }

    /* ─── Bottom Navigation Strip ─── */
    &__bottom {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
      padding-top: 2rem;
      border-top: 1px solid rgba(22, 0, 0, 0.12);

      @include mq(tablet) {
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 1.25rem;
      }
    }

    &__identity {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }

    &__monogram-link {
      display: inline-block;
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);

      &:hover {
        transform: scale(1.1);
      }
    }

    &__monogram-svg {
      display: block;
      color: color(secondary);
    }

    &__id-text {
      display: flex;
      flex-direction: column;
      gap: 2px;
      text-align: left;
    }

    &__author {
      font: 800 12px / 1 font-family(fraktion);
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: color(secondary);
    }

    &__role {
      font: 700 8.5px / 1 font-family(fraktion);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #246b45;
      opacity: 0.8;
    }

    &__nav {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font: 700 10.5px / 1 font-family(fraktion);
      letter-spacing: 0.14em;
      text-transform: uppercase;

      @include mq(phone) {
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.4rem;
        font-size: 9.5px;
      }
    }

    &__nav-link {
      color: color(secondary);
      text-decoration: none;
      transition: color 0.2s ease;

      span {
        color: #246b45;
        margin-right: 2px;
      }

      &:hover {
        color: #246b45;
      }
    }

    &__nav-slash {
      opacity: 0.3;
    }

    &__top-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.65rem 1.15rem;
      background: transparent;
      border: 1px solid rgba(22, 0, 0, 0.2);
      border-radius: 999px;
      font: 700 10px / 1 font-family(fraktion);
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: color(secondary);
      cursor: pointer;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);

      &:hover {
        background: color(secondary);
        color: color(primary);
        border-color: color(secondary);
        transform: translateY(-2px);

        .site-foot__top-arrow {
          transform: translateY(-2px);
        }
      }
    }

    &__top-arrow {
      font-size: 13px;
      transition: transform 0.25s ease;
    }

    /* ─── Final System Disclaimer ─── */
    &__disclaimer {
      margin-top: 2rem;
      padding-top: 1rem;
      border-top: 1px dashed rgba(22, 0, 0, 0.08);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      font: 700 8.5px / 1 font-family(fraktion);
      letter-spacing: 0.16em;
      text-transform: uppercase;
      opacity: 0.55;

      @include mq(tablet) {
        flex-direction: column;
        align-items: center;
        gap: 0.4rem;
        text-align: center;
      }
    }
  }

  @keyframes site-foot-pulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.45;
      transform: scale(0.85);
    }
  }
</style>
